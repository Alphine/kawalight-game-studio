{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kawalight.studio/schemas/export-manifest.v1.json",
  "title": "KGSM export manifest v1",
  "description": "Neutral manifest shipped with every export: asset provenance and project settings (SDD FR-018). Never contains API keys (NFR-002).",
  "type": "object",
  "required": [
    "manifestVersion", "projectName", "genre", "template", "exportedAt",
    "configHash", "runtime", "assets", "warnings"
  ],
  "properties": {
    "manifestVersion": { "const": "1.0.0" },
    "projectName": { "type": "string", "minLength": 1 },
    "genre": { "type": "string" },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "configHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "enum": ["starter", "generated", "imported"] },
          "provider": { "type": ["string", "null"], "default": null },
          "model": { "type": ["string", "null"], "default": null },
          "prompt": { "type": ["string", "null"], "default": null },
          "seed": { "type": ["integer", "null"], "default": null }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
