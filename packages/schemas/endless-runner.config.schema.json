{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kawalight.studio/schemas/endless-runner.config.v1.json",
  "title": "KGSM endless-runner template config v1",
  "description": "Engine-ready config for template phaser.endless-runner (SDD §3.2). Assembled from a validated blueprint; every field is consumed by the template or its assembler.",
  "type": "object",
  "required": [
    "schemaVersion", "template", "world", "player", "spawning",
    "obstacles", "scoring", "difficulty", "controls"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "phaser.endless-runner" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "seed": { "type": ["integer", "null"], "minimum": 0, "default": null },
    "world": {
      "type": "object",
      "required": ["width", "height", "groundY", "gravity", "baseSpeed",
                   "maxSpeed", "speedRampPerSec", "pxPerMeter"],
      "properties": {
        "width": { "type": "integer", "minimum": 480, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 270, "maximum": 1080 },
        "groundY": { "type": "number" },
        "gravity": { "type": "number", "minimum": 500, "maximum": 8000 },
        "baseSpeed": { "type": "number", "minimum": 60, "maximum": 1200 },
        "maxSpeed": { "type": "number", "minimum": 60, "maximum": 1600 },
        "speedRampPerSec": { "type": "number", "minimum": 0, "maximum": 100 },
        "pxPerMeter": { "type": "number", "minimum": 10, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "player": {
      "type": "object",
      "required": ["x", "width", "height", "slideHeight", "jumpVelocity"],
      "properties": {
        "x": { "type": "number" },
        "width": { "type": "number", "minimum": 8, "maximum": 128 },
        "height": { "type": "number", "minimum": 8, "maximum": 160 },
        "slideHeight": { "type": "number", "minimum": 4, "maximum": 160 },
        "jumpVelocity": { "type": "number", "minimum": 200, "maximum": 2500 }
      },
      "additionalProperties": false
    },
    "spawning": {
      "type": "object",
      "required": ["gracePx", "startGapPx", "minGapPx", "spawnAheadPx"],
      "properties": {
        "gracePx": { "type": "number", "minimum": 0, "maximum": 5000 },
        "startGapPx": { "type": "number", "minimum": 100, "maximum": 3000 },
        "minGapPx": { "type": "number", "minimum": 100, "maximum": 3000 },
        "spawnAheadPx": { "type": "number", "minimum": 0, "maximum": 500 }
      },
      "additionalProperties": false
    },
    "obstacles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sprite", "w", "h", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
          "sprite": { "type": "string", "minLength": 1 },
          "w": { "type": "number", "minimum": 4, "maximum": 256 },
          "h": { "type": "number", "minimum": 4, "maximum": 256 },
          "kind": { "type": "string", "enum": ["ground", "high"] },
          "hoverH": { "type": "number", "minimum": 0, "maximum": 400 }
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "required": ["coinScore", "milestoneEveryM"],
      "properties": {
        "coinScore": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "milestoneEveryM": { "type": "integer", "minimum": 0, "maximum": 100000 }
      },
      "additionalProperties": false
    },
    "difficulty": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "enum": ["easy", "normal", "hard"] }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": ["jump", "slide", "pause"],
      "properties": {
        "jump": { "type": "string", "minLength": 1 },
        "slide": { "type": "string", "minLength": 1 },
        "pause": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["sprites"],
      "properties": {
        "sprites": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
