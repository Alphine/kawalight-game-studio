{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kawalight.studio/schemas/side-scroller.config.v1.json",
  "title": "KGSM side-scroller template config v1",
  "description": "Engine-ready config for template phaser.side-scroller (SDD §3.3). Assembled from a validated blueprint; every field is consumed by the template or its assembler.",
  "type": "object",
  "required": [
    "schemaVersion", "template", "world", "player", "level",
    "scoring", "difficulty", "controls", "camera"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "template": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "phaser.side-scroller" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      },
      "additionalProperties": false
    },
    "seed": { "type": ["integer", "null"], "minimum": 0, "default": null },
    "world": {
      "type": "object",
      "required": ["width", "height", "levelWidth", "levelHeight", "gravity",
                   "maxFallSpeed", "killPlaneY"],
      "properties": {
        "width": { "type": "integer", "minimum": 480, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 270, "maximum": 1080 },
        "levelWidth": { "type": "integer", "minimum": 960, "maximum": 12000 },
        "levelHeight": { "type": "integer", "minimum": 270, "maximum": 2160 },
        "gravity": { "type": "number", "minimum": 500, "maximum": 8000 },
        "maxFallSpeed": { "type": "number", "minimum": 200, "maximum": 3000 },
        "killPlaneY": { "type": "number" }
      },
      "additionalProperties": false
    },
    "player": {
      "type": "object",
      "required": ["spawn", "width", "height", "moveSpeed", "acceleration",
                   "airControl", "jumpVelocity", "coyoteMs", "jumpBufferMs",
                   "maxJumps", "health", "invulnMs", "knockback", "stompBounce"],
      "properties": {
        "spawn": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        },
        "width": { "type": "number", "minimum": 8, "maximum": 128 },
        "height": { "type": "number", "minimum": 8, "maximum": 160 },
        "moveSpeed": { "type": "number", "minimum": 60, "maximum": 900 },
        "acceleration": { "type": "number", "minimum": 200, "maximum": 12000 },
        "airControl": { "type": "number", "minimum": 0, "maximum": 1 },
        "jumpVelocity": { "type": "number", "minimum": 200, "maximum": 2500 },
        "coyoteMs": { "type": "number", "minimum": 0, "maximum": 500 },
        "jumpBufferMs": { "type": "number", "minimum": 0, "maximum": 500 },
        "maxJumps": { "type": "integer", "minimum": 1, "maximum": 3 },
        "health": { "type": "integer", "minimum": 1, "maximum": 10 },
        "invulnMs": { "type": "number", "minimum": 0, "maximum": 5000 },
        "knockback": { "type": "number", "minimum": 0, "maximum": 1200 },
        "stompBounce": { "type": "number", "minimum": 100, "maximum": 2000 }
      },
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "required": ["platforms", "hazards", "enemies", "collectibles",
                   "checkpoints", "exit"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 8, "maximum": 12000 },
              "h": { "type": "number", "minimum": 8, "maximum": 2160 },
              "oneWay": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sprite", "x", "y", "w", "h"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
              "sprite": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 4, "maximum": 512 },
              "h": { "type": "number", "minimum": 4, "maximum": 512 },
              "damage": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }
            },
            "additionalProperties": false
          }
        },
        "enemies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "sprite", "x", "y", "w", "h",
                         "speed", "patrolMinX", "patrolMaxX"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
              "kind": { "type": "string", "enum": ["walker"] },
              "sprite": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 4, "maximum": 256 },
              "h": { "type": "number", "minimum": 4, "maximum": 256 },
              "speed": { "type": "number", "minimum": 0, "maximum": 600 },
              "patrolMinX": { "type": "number" },
              "patrolMaxX": { "type": "number" },
              "damage": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 }
            },
            "additionalProperties": false
          }
        },
        "collectibles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "r": { "type": "number", "minimum": 2, "maximum": 64, "default": 10 },
              "score": { "type": "integer", "minimum": 0, "maximum": 10000 }
            },
            "additionalProperties": false
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x", "y", "w", "h"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number", "minimum": 4, "maximum": 512 },
              "h": { "type": "number", "minimum": 4, "maximum": 1024 }
            },
            "additionalProperties": false
          }
        },
        "exit": {
          "type": "object",
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number", "minimum": 8, "maximum": 512 },
            "h": { "type": "number", "minimum": 8, "maximum": 1024 },
            "sprite": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["coinScore", "stompScore", "timeBonusPerSec", "parTimeSec"],
      "properties": {
        "coinScore": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "stompScore": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "timeBonusPerSec": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "parTimeSec": { "type": "integer", "minimum": 0, "maximum": 3600 }
      },
      "additionalProperties": false
    },
    "difficulty": {
      "type": "object",
      "required": ["preset"],
      "properties": {
        "preset": { "type": "string", "enum": ["easy", "normal", "hard"] }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": ["left", "right", "jump", "pause"],
      "properties": {
        "left": { "type": "string", "minLength": 1 },
        "right": { "type": "string", "minLength": 1 },
        "jump": { "type": "string", "minLength": 1 },
        "pause": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["followLerp", "deadzoneX", "deadzoneY"],
      "properties": {
        "followLerp": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "deadzoneX": { "type": "number", "minimum": 0, "maximum": 1920 },
        "deadzoneY": { "type": "number", "minimum": 0, "maximum": 1080 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["sprites"],
      "properties": {
        "sprites": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
