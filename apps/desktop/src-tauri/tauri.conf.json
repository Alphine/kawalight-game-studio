{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kawalight Game Studio Maker",
  "version": "0.1.0",
  "identifier": "studio.kawalight.maker",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Kawalight Game Studio Maker",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/kgsm-worker"]
  }
}
